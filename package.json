{
  "dependencies": {
    "date-fns": "^4.1.0",
    "lucide-preact": "^0.564.0",
    "preact": "^10.28.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.3",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "postcss": "^8.4.38",
    "prettier": "^3.3.1",
    "prettier-plugin-tailwindcss": "^0.6.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "name": "react-vite-tailwind-prettier",
  "private": true,
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext js,jsx,ts,tsx --report-unused-disable-directives",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "typecheck": "tsc -b --noEmit",
    "ddo": "npm run format && npm run typecheck && npm run lint",
    "generate-icon": "node scripts/generate-icon.js"
  },
  "type": "module",
  "version": "0.0.0"
}
